# Application
APP_ENV=development
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://soar:soar_local_dev_password@postgres:5432/soar_lite

# PostgreSQL container
POSTGRES_DB=soar_lite
POSTGRES_USER=soar
POSTGRES_PASSWORD=soar_local_dev_password

# Frontend (browser-visible configuration; do not place secrets here)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Planned integrations — supply real values only in an untracked .env file
ABUSEIPDB_API_KEY=
WEBHOOK_SECRET=replace-with-a-long-random-secret
ANALYST_API_KEY=replace-with-a-long-random-analyst-key
